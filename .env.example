# Supabase (shared with PLCC Canaan) — browser-safe anon key only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Auth email redirect (must be allow-listed in Supabase Auth → Redirect URLs).
# Defaults to {origin}/auth/callback when unset.
# VITE_AUTH_REDIRECT_URL=https://your-connect-host/auth/callback

# Server-only (Vercel / Vite). Never use a VITE_ prefix. Never commit real values.
# HTTPS origin of PLCC Canaan (no path, query, fragment, or credentials).
# Example: https://plcc-opal.vercel.app
# VAULT_API_ORIGIN=

# Giving page (PLCC Tithe). Defaults to https://plcc-tithe.vercel.app
# VITE_TITHE_URL=

# AI assistant — OpenAI is primary; Gemini is fallback if OpenAI fails or is unset.
# OPENAI_API_KEY is exposed to the Vite client build (see vite.config envPrefix).
OPENAI_API_KEY=your-openai-api-key
# Optional fallback:
# VITE_GEMINI_API_KEY=your-gemini-api-key


# Optional: force a specific YouTube video (normally auto-fetched from @khiireofficial)
# VITE_LATEST_YOUTUBE_URL=
